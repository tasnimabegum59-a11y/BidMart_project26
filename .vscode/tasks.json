{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "BidMart: Run Flask app",
			"type": "shell",
			"command": "python",
			"args": [
				"app.py"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Start BidMart",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"run_bidmart.cmd"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}